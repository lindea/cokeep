DATABASE_URL="postgresql://cokeep:cokeep@localhost:5432/cokeep?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d
APP_BASE_URL=http://localhost:3000
APP_DEEP_LINK_SCHEME=cokeep
APP_STORE_URL=https://apps.apple.com/app/cokeep
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Email (optional — logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoKeep <noreply@cokeep.app>"

# SMS (optional — server-side Twilio; iOS app opens Messages for manual send by default)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push via APNs (recommended for the native iOS app) or Firebase Cloud Messaging
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.cokeep.CoKeep
# Local dev: path to downloaded AuthKey_XXXX.p8
APNS_KEY_PATH=
# Heroku/cloud: paste full .p8 contents (use `\n` for line breaks in one line)
# APNS_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APNS_KEY=
FCM_CREDENTIALS_PATH=
