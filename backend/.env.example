DATABASE_URL="postgresql://cokeep:cokeep@localhost:5432/cokeep?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d
APP_BASE_URL=http://localhost:3000
APP_DEEP_LINK_SCHEME=cokeep
APP_STORE_URL=https://apps.apple.com/app/cokeep
# Install link for invites to non-users (TestFlight during beta)
APP_DOWNLOAD_URL=https://testflight.apple.com/join/gnRXHXyC
# Set true after App Store launch to auto-open Messages for non-user invites
INVITE_NON_USER_OPEN_MESSAGES=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# AWS S3 for images (object photos, avatars, receipts). Falls back to local disk when unset.
AWS_S3_BUCKET=
AWS_S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional custom/CDN base URL (otherwise uses https://BUCKET.s3.REGION.amazonaws.com/...)
AWS_S3_PUBLIC_BASE_URL=

# Email (optional — logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoKeep <noreply@cokeep.app>"

# Push via native APNs
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.cokeep.CoKeep
# Local dev: path to downloaded AuthKey_XXXX.p8
APNS_KEY_PATH=
# Heroku/cloud: paste full .p8 contents (use `\n` for line breaks in one line)
# APNS_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APNS_KEY=
# true = production APNs (TestFlight/App Store). false = sandbox (Xcode debug).
# Defaults to true when NODE_ENV=production.
# APNS_PRODUCTION=true
# Optional: Heroku Scheduler can POST /api/internal/run-due-notifications
# with header X-Cron-Secret matching this value (keeps pushes alive if the dyno slept).
# CRON_SECRET=

# Admin UI at /admin (launch splash + force-update). Required for login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
